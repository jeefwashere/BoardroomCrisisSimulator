# Copy values into the application's Coolify environment settings.
# Do not use .env or .env.local as a Docker build context or frontend build input.
BOARDROOM_ALLOWED_ORIGINS=https://boardroomcrisis.duckdns.org
# Trust proxy headers only on the private backend network. No backend domain/ports.
FORWARDED_ALLOW_IPS=*

# Fixed by compose.yaml, rather than operator supplied:
# BOARDROOM_SECURE_COOKIE=true
# BOARDROOM_RECORDINGS_DIR=/data/recordings
# BOARDROOM_TTS_LEDGER=/data/voice/ledger.sqlite
# BOARDROOM_TTS_CACHE=/data/voice/tts-cache

# Gemini for the current main game. Enter one key in Coolify only.
GOOGLE_API_KEY=
VERTEX_API_KEY=
BOARDROOM_VERTEX_ENABLED=true
BOARDROOM_VERTEX_CAP_CENTS=2000
BOARDROOM_VERTEX_UNLIMITED=false
# Fixed persistent path: BOARDROOM_VERTEX_LEDGER=/data/voice/vertex/ledger.sqlite

# Existing hosted LFM3 service. Leave blank for the existing offline fallback.
REHEARSAL_API_URL=
REHEARSAL_APP_KEY=
REHEARSAL_SITE_TOKEN=

# Spoken briefing uses the approved cap and verified Flash price fixed in compose.yaml.
# The ElevenLabs key is supplied only through backend runtime settings.
ELEVENLABS_API_KEY=
BOARDROOM_TTS_ENABLED=true
BOARDROOM_STT_ENABLED=false
BOARDROOM_VOICE_BUDGET_USD=100
BOARDROOM_TTS_USD_PER_1K=0.04
BOARDROOM_STT_USD_PER_MINUTE=0
BOARDROOM_TTS_VOICE_ID=
